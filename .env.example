# Database
DB_CONNECTION=Host=postgres;Database=lillyrecorder;Username=postgres;Password=

# Redis
REDIS_URL=redis:6379

# LiveKit
LIVEKIT_URL=http://livekit:7880
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# S3 / MinIO (local dev)
S3_BUCKET=lilly-recordings
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1

# App
FRONTEND_URL=http://localhost:3000
EGRESS_TEMPLATE_URL=http://localhost:3000/egress/participant

# Mail (Mailhog in local Docker setup)
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
MAIL_ENABLED=true
MAIL_FROM=no-reply@lillyrecorder.local

ASPNETCORE_ENVIRONMENT=Development
